{
  "name": "ytpd-desktop",
  "productName": "Playlist Grabber",
  "version": "1.0.8",
  "description": "Desktop app for downloading YouTube playlists, channels, and videos",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare:resources": "node scripts/prepare-resources.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && npm run prepare:resources && electron-builder",
    "dist:win": "cross-env YTPD_PLATFORMS=win npm run dist -- --win",
    "dist:linux": "cross-env YTPD_PLATFORMS=linux npm run dist -- --linux",
    "dist:mac": "cross-env YTPD_PLATFORMS=osx-arm64,osx-x64 npm run dist -- --mac"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cross-env": "^10.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0",
    "png2icons": "^2.0.1",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.playlistgrabber.desktop",
    "productName": "Playlist Grabber",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "resources/frontend",
        "to": "frontend"
      },
      {
        "from": "resources/frontend/node_modules",
        "to": "frontend/node_modules"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "resources/backend-win",
          "to": "backend"
        },
        {
          "from": "resources/ffmpeg-win",
          "to": "ffmpeg"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "zip",
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "extraResources": [
        {
          "from": "resources/backend-osx-${arch}",
          "to": "backend"
        },
        {
          "from": "resources/ffmpeg-osx-${arch}",
          "to": "ffmpeg"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icons",
      "category": "AudioVideo",
      "extraResources": [
        {
          "from": "resources/backend-linux",
          "to": "backend"
        },
        {
          "from": "resources/ffmpeg-linux",
          "to": "ffmpeg"
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "anonymous020786-dotcom",
      "repo": "ytpd-desktop"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
